    <script>
      (function(){
        "use strict";
        var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        /* ----- mobile menu ----- */
        var header = document.getElementById("siteHeader");
        var menuBtn = document.getElementById("menuBtn");
        menuBtn.addEventListener("click", function(){
          var open = header.classList.toggle("open");
          menuBtn.setAttribute("aria-expanded", open ? "true" : "false");
          menuBtn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        });
        document.getElementById("mobileNav").addEventListener("click", function(e){
          if (e.target.tagName === "A") header.classList.remove("open");
        });

        /* ----- live clock (Asia/Kolkata) ----- */
        var t1 = document.getElementById("clockTime"), t2 = document.getElementById("clockTime2"),
            dEl = document.getElementById("clockDate");
        function tick(){
          try {
            var now = new Date();
            var t = now.toLocaleTimeString("en-IN",{timeZone:"Asia/Kolkata",hour:"numeric",minute:"2-digit",hour12:true});
            var d = now.toLocaleDateString("en-IN",{timeZone:"Asia/Kolkata",day:"numeric",month:"long",year:"numeric"});
            t1.textContent = t; t2.textContent = t; dEl.textContent = d;
          } catch(e){ t1.textContent = ""; }
        }
        tick(); setInterval(tick, 20000);

        /* ----- notebook role card: auto-swap + tap to flip ----- */
        var noteTitles = ["Frontend Developer","Freelancer","VibeCoder","photographer"];
        var noteCard = document.getElementById("noteCard");
        var noteFace = document.getElementById("noteFace");
        var noteTitle = document.getElementById("noteTitle");
        var noteCount = document.getElementById("noteCount");
        var noteIdx = 0, noteTimer = null, noteBusy = false;
        function renderNote(){
          noteTitle.textContent = noteTitles[noteIdx];
          noteCount.textContent = "0" + (noteIdx + 1) + " / 04";
          noteCard.setAttribute("aria-label", "Current role: " + noteTitles[noteIdx] + ". Activate to see the next role.");
        }
        function advanceNote(){
          if (noteBusy) return;
          var target = (noteIdx + 1) % noteTitles.length;
          if (reduced) { noteIdx = target; renderNote(); return; }
          noteBusy = true;
          noteFace.classList.remove("in");
          noteFace.classList.add("out");
          setTimeout(function(){
            noteIdx = target;
            renderNote();
            noteFace.classList.remove("out");
            noteFace.classList.add("in");
            setTimeout(function(){ noteFace.classList.remove("in"); noteBusy = false; }, 960);
          }, 810);
        }
        function restartNoteTimer(){
          if (noteTimer) clearInterval(noteTimer);
          noteTimer = null;
          if (!reduced) noteTimer = setInterval(function(){ if (!document.hidden) advanceNote(); }, 3600);
        }
        noteCard.addEventListener("click", function(){ advanceNote(); restartNoteTimer(); });
        noteCard.addEventListener("keydown", function(e){
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); advanceNote(); restartNoteTimer(); }
        });
        restartNoteTimer();

        /* ----- theme pull cord ----- */
        var rootEl = document.documentElement;
        var cord = document.getElementById("cord");
        var cordBtn = document.getElementById("cordBtn");
        var cordLine = document.getElementById("cordLine");
        function syncCord(){
          var dark = rootEl.getAttribute("data-theme") === "dark";
          cordBtn.setAttribute("aria-pressed", dark ? "true" : "false");
          cordBtn.setAttribute("aria-label", dark ? "Switch to light mode" : "Switch to dark mode");
        }
        function applyTheme(dark){
          rootEl.setAttribute("data-theme", dark ? "dark" : "light");
          try { localStorage.setItem("ayush-theme", dark ? "dark" : "light"); } catch(e){}
          syncCord();
        }
        var cordBusy = false;
        function pullCord(){
          if (cordBusy) return;
          var dark = rootEl.getAttribute("data-theme") !== "dark";
          if (reduced) { applyTheme(dark); return; }
          cordBusy = true;
          cord.classList.add("pulling");
          setTimeout(function(){
            applyTheme(dark);
            cord.classList.remove("pulling");
            setTimeout(function(){ cordBusy = false; }, 580);
          }, 160);
        }
        cordBtn.addEventListener("click", pullCord);
        cordLine.addEventListener("click", pullCord);
        syncCord();

        /* ----- reveal on scroll + skill counters ----- */
        var countersDone = false;
        function runCounters(scope){
          scope.querySelectorAll("[data-count]").forEach(function(el){
            var target = parseInt(el.getAttribute("data-count"), 10);
            if (reduced) { el.textContent = target; return; }
            var start = null;
            function step(ts){
              if (!start) start = ts;
              var p = Math.min((ts - start) / 1000, 1);
              el.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
              if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          });
        }
        var io = new IntersectionObserver(function(entries){
          entries.forEach(function(en){
            if (en.isIntersecting) {
              en.target.classList.add("in");
              if (en.target.id === "abilityCard" && !countersDone) { countersDone = true; runCounters(en.target); }
              io.unobserve(en.target);
            }
          });
        }, { threshold: 0.18 });
        document.querySelectorAll(".rv").forEach(function(el){ io.observe(el); });

        /* ----- ability card: 3D tilt + drag ----- */
        var card = document.getElementById("abilityCard");
        var rx = 0, ry = 0, dx = 0, dy = 0;
        var dragging = false, startX = 0, startY = 0, baseX = 0, baseY = 0, moved = false;
        function apply(){
          card.style.transform = "translate(" + dx + "px," + dy + "px) rotateX(" + rx + "deg) rotateY(" + ry + "deg)";
        }
        card.addEventListener("pointerdown", function(e){
          dragging = true; moved = false;
          startX = e.clientX; startY = e.clientY; baseX = dx; baseY = dy;
          card.setPointerCapture(e.pointerId);
          card.classList.add("grabbing");
          card.style.transition = "none";
        });
        card.addEventListener("pointermove", function(e){
          var r = card.getBoundingClientRect();
          card.style.setProperty("--gx", ((e.clientX - r.left) / r.width * 100) + "%");
          card.style.setProperty("--gy", ((e.clientY - r.top) / r.height * 100) + "%");
          if (dragging) {
            dx = baseX + (e.clientX - startX);
            dy = baseY + (e.clientY - startY);
            if (Math.abs(e.clientX - startX) + Math.abs(e.clientY - startY) > 4) moved = true;
            rx = Math.max(-10, Math.min(10, -dy / 14));
            ry = Math.max(-12, Math.min(12, dx / 14));
            apply();
          } else if (!reduced) {
            var px = (e.clientX - r.left) / r.width - 0.5;
            var py = (e.clientY - r.top) / r.height - 0.5;
            rx = -py * 13; ry = px * 15;
            card.style.transition = "transform .12s ease-out";
            apply();
          }
        });
        function release(){
          if (!dragging) return;
          dragging = false;
          card.classList.remove("grabbing");
          card.style.transition = "transform .65s cubic-bezier(.22,1.4,.36,1)";
          dx = 0; dy = 0; rx = 0; ry = 0;
          apply();
          setTimeout(function(){ card.style.transition = ""; }, 700);
        }
        card.addEventListener("pointerup", release);
        card.addEventListener("pointercancel", release);
        card.addEventListener("pointerleave", function(){
          if (!dragging && !reduced) {
            rx = 0; ry = 0;
            card.style.transition = "transform .5s ease";
            apply();
          }
        });

        /* ----- doors: stage 1 half open (peek), stage 2 opens the project listing page directly ----- */
        var doorways = Array.prototype.slice.call(document.querySelectorAll("[data-doorway]"));
        var room = document.getElementById("projectRoom");
        var roomImg = document.getElementById("roomImg");
        var roomEyebrow = document.getElementById("roomEyebrow");
        var roomTitle = document.getElementById("roomTitle");
        var roomDesc = document.getElementById("roomDesc");
        var roomTech = document.getElementById("roomTech");
        var roomOpen = document.getElementById("roomOpen");
        var roomBack = document.getElementById("roomBack");
        var roomOpenState = false, lastDoorLeaf = null;
        function setDoorStage(way, stage, focusTarget){
          /* stage: 0 = closed, 1 = half open */
          var leaf = way.querySelector("[data-door-open]");
          var hint = way.querySelector(".leaf-hint");
          way.classList.toggle("is-half", stage === 1);
          way.classList.remove("is-open");
          leaf.setAttribute("aria-expanded", stage === 1 ? "true" : "false");
          if (hint) hint.textContent = stage === 1 ? "Tap again — view projects" : "Tap to open";
          if (focusTarget) {
            setTimeout(function(){ leaf.focus({ preventScroll: true }); }, reduced ? 0 : 120);
          }
        }
        function doorStage(way){
          if (way.classList.contains("is-half")) return 1;
          return 0;
        }
        function resetDoorway(way){
          way.classList.remove("is-half", "is-open");
          var leaf = way.querySelector("[data-door-open]");
          leaf.setAttribute("aria-expanded", "false");
          var hint = way.querySelector(".leaf-hint");
          if (hint) hint.textContent = "Tap to open";
        }
        function plateLabel(way){
          var plate = way.querySelector(".plate");
          if (!plate) return "";
          return plate.innerHTML.replace(/<br\s*\/?>/gi, " ").replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
        }
        function openProjectRoom(way){
          var unit = way.parentElement;
          var img = way.querySelector(".door-inside img");
          var title = way.querySelector(".inside-body h3");
          var link = way.querySelector(".open-project");
          var desc = unit ? unit.querySelector(".door-about-line") : null;
          var tech = unit ? unit.querySelector(".door-tech") : null;
          if (img) { roomImg.src = img.getAttribute("src"); roomImg.alt = img.getAttribute("alt") || ""; }
          roomEyebrow.textContent = plateLabel(way);
          if (title) roomTitle.textContent = title.textContent;
          if (desc) roomDesc.textContent = desc.textContent.replace(/\s+/g, " ").trim();
          if (tech) roomTech.innerHTML = tech.innerHTML;
          if (link) roomOpen.setAttribute("href", link.getAttribute("href"));
          room.hidden = false;
          room.scrollTop = 0;
          roomOpenState = true;
          document.body.style.overflow = "hidden";
          roomBack.focus({ preventScroll: true });
        }
        function closeProjectRoom(focusLeaf){
          if (!roomOpenState) return;
          room.hidden = true;
          roomOpenState = false;
          document.body.style.overflow = "";
          doorways.forEach(resetDoorway);
          if (focusLeaf && lastDoorLeaf) lastDoorLeaf.focus({ preventScroll: true });
        }
        function enterProject(way){
          if (roomOpenState) return;
          lastDoorLeaf = way.querySelector("[data-door-open]");
          lastDoorLeaf.setAttribute("aria-expanded", "true");
          openProjectRoom(way);
        }
        doorways.forEach(function(way){
          var leaf = way.querySelector("[data-door-open]");
          leaf.addEventListener("click", function(){
            if (roomOpenState) return;
            var stage = doorStage(way);
            if (stage === 0) {
              doorways.forEach(function(other){ if (other !== way && doorStage(other) !== 0) setDoorStage(other, 0, false); });
              setDoorStage(way, 1, false);
            } else if (stage === 1) {
              enterProject(way);
            }
          });
        });
        document.getElementById("roomBack").addEventListener("click", function(){ closeProjectRoom(true); });
        document.getElementById("roomBack2").addEventListener("click", function(){ closeProjectRoom(true); });
        document.getElementById("roomClose").addEventListener("click", function(){ closeProjectRoom(true); });
        room.addEventListener("click", function(e){
          if (e.target === room || e.target.id === "roomCenter") closeProjectRoom(true);
        });
        document.addEventListener("keydown", function(e){
          if (e.key !== "Escape") return;
          if (roomOpenState) { closeProjectRoom(true); return; }
          doorways.forEach(function(way){ if (doorStage(way) !== 0) setDoorStage(way, 0, true); });
        });

        /* ----- story progress ----- */
        var timeline = document.getElementById("timeline");
        var prog = document.getElementById("timelineProg");
        var storyNow = document.getElementById("storyNow");
        var storyBar = document.getElementById("storyBar");
        var entries = Array.prototype.slice.call(timeline.querySelectorAll(".entry"));
        function onScroll(){
          var r = timeline.getBoundingClientRect();
          var vh = window.innerHeight;
          var total = r.height - vh * 0.35;
          var done = Math.min(Math.max((vh * 0.62 - r.top) / Math.max(total, 1), 0), 1);
          prog.style.height = (done * (r.height - 16)) + "px";
          storyBar.style.transform = "scaleX(" + done + ")";
          var current = 1;
          entries.forEach(function(en, i){
            var er = en.getBoundingClientRect();
            var lit = er.top < vh * 0.62;
            en.classList.toggle("lit", lit);
            if (lit) current = i + 1;
          });
          storyNow.textContent = "0" + current;
        }
        var ticking = false;
        window.addEventListener("scroll", function(){
          if (!ticking) { ticking = true; requestAnimationFrame(function(){ onScroll(); ticking = false; }); }
        }, { passive: true });
        window.addEventListener("resize", onScroll);
        onScroll();

        /* ----- ability card modal: open / close / particles / tilt ----- */
        var modal = document.getElementById("abilityModal");
        var heroBtn = document.getElementById("heroPhotoBtn");
        var heroHint = document.getElementById("heroPhotoHint");
        var closeBtn = document.getElementById("abilityClose");
        var cardWrap = document.getElementById("abilityCardWrap");
        var particlesBox = document.getElementById("abilityParticles");
        var particlesBuilt = false;
        function buildParticles(){
          if (particlesBuilt) return;
          particlesBuilt = true;
          for (var i = 0; i < 70; i++) {
            var s = document.createElement("span");
            s.className = "particle";
            var size = 2 + Math.random() * 4.5;
            s.style.width = size + "px";
            s.style.height = size + "px";
            s.style.left = (Math.random() * 100) + "%";
            s.style.top = (Math.random() * 100) + "%";
            s.style.opacity = (0.3 + Math.random() * 0.65).toFixed(2);
            s.style.animationDelay = (Math.random() * 3.4).toFixed(2) + "s";
            s.style.animationDuration = (2.4 + Math.random() * 2.6).toFixed(2) + "s";
            particlesBox.appendChild(s);
          }
        }
        var sparklesBox = document.getElementById("abilitySparkles");
        var sparklesBuilt = false;
        function buildSparkles(){
          if (sparklesBuilt || !sparklesBox) return;
          sparklesBuilt = true;
          /* positions clustered around the card perimeter (percent of the wrap) */
          var spots = [
            [4,-1],[22,-2],[48,-1],[74,-2],[96,0],
            [-1,22],[101,26],[-2,52],[102,55],[-1,80],[101,82],
            [8,101],[34,102],[62,101],[88,102],[50,-2]
          ];
          for (var i = 0; i < spots.length; i++) {
            var sp = document.createElement("span");
            sp.className = "sparkle";
            var size = 9 + Math.random() * 10;
            sp.style.width = size + "px";
            sp.style.height = size + "px";
            sp.style.left = spots[i][0] + "%";
            sp.style.top = spots[i][1] + "%";
            sp.style.animationDelay = (Math.random() * 3.8).toFixed(2) + "s";
            sp.style.animationDuration = (3.2 + Math.random() * 1.8).toFixed(2) + "s";
            sparklesBox.appendChild(sp);
          }
        }
        var lastFocus = null;
        function openModal(){
          buildParticles();
          buildSparkles();
          lastFocus = document.activeElement;
          modal.hidden = false;
          /* restart the entrance animation */
          modal.classList.remove("open");
          void modal.offsetWidth;
          modal.classList.add("open");
          document.body.style.overflow = "hidden";
          closeBtn.focus();
          tiltStart();
        }
        function closeModal(){
          tiltStop();
          modal.hidden = true;
          modal.classList.remove("open");
          document.body.style.overflow = "";
          cardWrap.style.transform = "";
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }
        heroBtn.addEventListener("click", openModal);
        heroHint.addEventListener("click", openModal);
        heroBtn.addEventListener("keydown", function(e){
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openModal(); }
        });
        closeBtn.addEventListener("click", closeModal);
        modal.addEventListener("click", function(e){
          if (e.target === modal || e.target.id === "abilityCenter") closeModal();
        });
        document.addEventListener("keydown", function(e){
          if (e.key === "Escape" && !modal.hidden) closeModal();
        });
        /* ----- ability card modal: dynamic spring tilt + moving glare + idle float ----- */
        var tilt = { rx: 0, ry: 0, tx: 0, ty: 0, vx: 0, vy: 0, raf: 0, last: 0, dragging: false };
        var cardEl = cardWrap.querySelector(".acard2");
        function tiltLoop(now){
          tilt.raf = 0;
          if (modal.hidden) return;
          now = now || performance.now();
          if (!tilt.dragging && now - tilt.last > 2600) {
            /* gentle idle sway when the pointer leaves the card alone */
            tilt.tx = Math.sin(now / 2300) * 2.4;
            tilt.ty = Math.cos(now / 2800) * 3.0;
          }
          tilt.vx += (tilt.tx - tilt.rx) * 0.07;
          tilt.vy += (tilt.ty - tilt.ry) * 0.07;
          tilt.vx *= 0.8; tilt.vy *= 0.8;
          tilt.rx += tilt.vx; tilt.ry += tilt.vy;
          cardWrap.style.transform = "rotateX(" + tilt.rx.toFixed(3) + "deg) rotateY(" + tilt.ry.toFixed(3) + "deg)";
          tilt.raf = requestAnimationFrame(tiltLoop);
        }
        function tiltStart(){
          if (reduced || tilt.raf) return;
          tilt.last = performance.now();
          tilt.raf = requestAnimationFrame(tiltLoop);
        }
        function tiltStop(){
          if (tilt.raf) cancelAnimationFrame(tilt.raf);
          tilt.raf = 0;
          tilt.rx = 0; tilt.ry = 0; tilt.tx = 0; tilt.ty = 0; tilt.vx = 0; tilt.vy = 0; tilt.dragging = false;
          cardWrap.classList.remove("tilting", "dragging");
        }
        function tiltFromPointer(e){
          if (reduced || modal.hidden) return;
          var r = cardWrap.getBoundingClientRect();
          if (!r.width) return;
          var px = (e.clientX - r.left) / r.width - 0.5;
          var py = (e.clientY - r.top) / r.height - 0.5;
          px = Math.max(-1, Math.min(1, px));
          py = Math.max(-1, Math.min(1, py));
          tilt.tx = Math.max(-13, Math.min(13, -py * 18));
          tilt.ty = Math.max(-15, Math.min(15, px * 21));
          tilt.last = performance.now();
          cardWrap.classList.add("tilting");
          if (cardEl) {
            var cr = cardEl.getBoundingClientRect();
            if (cr.width) {
              var gx = ((e.clientX - cr.left) / cr.width) * 100;
              var gy = ((e.clientY - cr.top) / cr.height) * 100;
              cardEl.style.setProperty("--gx", gx.toFixed(1) + "%");
              cardEl.style.setProperty("--gy", gy.toFixed(1) + "%");
              /* holographic foil follows the pointer: hue angle + gradient position */
              cardEl.style.setProperty("--holo-angle", (115 + px * 90 - py * 40).toFixed(1) + "deg");
              cardEl.style.setProperty("--holo-pos", (50 + px * 65).toFixed(1) + "%");
            }
          }
          tiltStart();
        }
        function tiltRelease(){
          if (!tilt.dragging) return;
          tilt.dragging = false;
          tilt.tx = 0; tilt.ty = 0;
          tilt.last = performance.now();
          cardWrap.classList.remove("dragging");
          setTimeout(function(){ if (!tilt.dragging) cardWrap.classList.remove("tilting"); }, 350);
        }
        if (!reduced) {
          modal.addEventListener("pointermove", tiltFromPointer);
          cardWrap.addEventListener("pointerdown", function(e){
            tilt.dragging = true;
            cardWrap.classList.add("dragging");
            tiltFromPointer(e);
          });
          window.addEventListener("pointerup", tiltRelease);
          window.addEventListener("pointercancel", tiltRelease);
          modal.addEventListener("pointerleave", function(){
            tilt.tx = 0; tilt.ty = 0; tilt.last = performance.now();
            cardWrap.classList.remove("tilting");
          });
        }

        /* ----- photo colour on touch: tap the hero photo / modal photo ----- */
        heroBtn.addEventListener("pointerdown", function(){ heroBtn.classList.add("color-on"); });
        ["pointerup", "pointercancel", "pointerleave"].forEach(function(ev){
          heroBtn.addEventListener(ev, function(){
            setTimeout(function(){ heroBtn.classList.remove("color-on"); }, 450);
          });
        });
        var abilityPhoto = document.getElementById("abilityPhoto");
        abilityPhoto.addEventListener("click", function(){ abilityPhoto.classList.toggle("show-color"); });

        /* ----- back to top ----- */
        document.getElementById("toTop").addEventListener("click", function(){
          window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
        });
      })();
    </script>
  </body>
</html>
