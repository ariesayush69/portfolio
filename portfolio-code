<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="Ayush Kumar — frontend developer, freelancer and founder of Societee. B.Tech CS (AI & ML) at PW Institute of Innovation." />
    <link rel="icon" href="data:," />
    <link rel="preload" as="image" href="data:image/jpeg;base64," />
    <title>Ayush Kumar — Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script>document.documentElement.classList.add('js');try{var _t=localStorage.getItem('ayush-theme');document.documentElement.setAttribute('data-theme',_t==='light'?'light':'dark');}catch(e){document.documentElement.setAttribute('data-theme','dark');}</script>
    <style>
      :root{
        --paper:#f4f1ea;
        --paper-2:#ece7db;
        --card:#fbf9f4;
        --ink:#17140f;
        --ink-soft:#3d382e;
        --muted:#75705f;
        --line:rgba(23,20,15,.13);
        --navy:#22385c;
        --plum:#4b3049;
        --sage:#7e8c76;
        --terra:#b85c33;
        --brass-1:#eed488;
        --brass-2:#c49a3a;
        --dark:#14110d;
        --dark-2:#221d16;
        --radius:20px;
        --font-d:"Inter Tight",system-ui,sans-serif;
        --font-b:"Inter",system-ui,sans-serif;
        --font-m:"IBM Plex Mono",ui-monospace,monospace;
        color-scheme:light;
      }
      html[data-theme="dark"]{
        color-scheme:dark;
        --paper:#171410;
        --paper-2:#262019;
        --card:#211c15;
        --ink:#f2eee6;
        --ink-soft:#d9d2c0;
        --muted:#a99e87;
        --line:rgba(242,238,230,.16);
        --navy:#6f97d6;
        --plum:#9a6f96;
        --sage:#9db094;
        --terra:#d97e4f;
      }
      html[data-theme="dark"] .portrait .arch{background:#2b251c;}
      html[data-theme="dark"] .door-frame{background:#2b251c;}
      html[data-theme="dark"] .entry .photos figure,
      html[data-theme="dark"] .entry .shows figure{background:#2b251c;}
      html[data-theme="dark"] .avatar{background:#22385c;}
      html[data-theme="dark"] .contact{background:#100d0a;}
      html[data-theme="dark"] :focus-visible{outline-color:var(--terra);}
      body{transition:background-color .45s ease,color .45s ease;}
      header{transition:background-color .45s ease,border-color .45s ease;}
      html{scroll-behavior:smooth;}
      html,body{overflow-x:clip;}
      body{
        margin:0;background:var(--paper);color:var(--ink);
        font-family:var(--font-b);font-size:16px;line-height:1.55;
        -webkit-font-smoothing:antialiased;
      }
      h1,h2,h3,p,ul,figure{margin:0;}
      ul{padding:0;list-style:none;}
      a{color:inherit;}
      img{display:block;max-width:100%;}
      :focus-visible{outline:2px solid var(--navy);outline-offset:3px;border-radius:4px;}
      .wrap{max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);}
      .hero-grid>*,.ability-grid>*,.story-grid>*,.foot>*{min-width:0;}
      .label{
        font-family:var(--font-m);font-size:12px;letter-spacing:.14em;
        text-transform:uppercase;color:var(--muted);
        display:flex;align-items:center;gap:9px;
      }
      .label::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--terra);flex:none;}

      /* ---------- reveal on scroll ---------- */
      .js .rv{opacity:0;transform:translateY(26px);transition:opacity .8s ease,transform .8s cubic-bezier(.22,.8,.3,1);}
      .js .rv.in{opacity:1;transform:none;}

      /* ---------- header ---------- */
      header{
        position:fixed;inset:0 0 auto 0;z-index:60;
        background:color-mix(in srgb,var(--paper) 88%,transparent);
        backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
        border-bottom:1px solid var(--line);
      }
      .bar{display:flex;align-items:center;gap:28px;min-height:64px;}
      .brand{font-family:var(--font-d);font-weight:700;font-size:17px;letter-spacing:-.01em;text-decoration:none;white-space:nowrap;}
      .brand span{color:var(--muted);font-weight:500;}
      nav.main{margin-left:auto;display:flex;gap:26px;}
      nav.main a{
        text-decoration:none;font-size:15px;font-weight:500;color:var(--ink-soft);
        padding:8px 2px;position:relative;
      }
      nav.main a::after{content:"";position:absolute;left:0;right:100%;bottom:2px;height:2px;background:var(--ink);transition:right .3s ease;}
      nav.main a:hover::after{right:0;}
      .clock{
        margin-left:8px;display:flex;align-items:center;gap:10px;white-space:nowrap;
        border:1px solid var(--line);border-radius:999px;padding:8px 16px;
        font-size:13.5px;color:var(--muted);background:var(--card);
      }
      .clock b{color:var(--ink);font-weight:600;font-variant-numeric:tabular-nums;}
      .clock .dotsep{width:3px;height:3px;border-radius:50%;background:var(--muted);}
      .menu-btn{
        display:none;margin-left:auto;width:44px;height:44px;border:1px solid var(--line);
        border-radius:12px;background:var(--card);cursor:pointer;align-items:center;justify-content:center;
      }
      .menu-btn svg{width:20px;height:20px;}
      .mobile-nav{display:none;border-top:1px solid var(--line);padding:10px clamp(20px,4vw,48px) 16px;}
      .mobile-nav a{display:block;padding:11px 0;font-family:var(--font-d);font-weight:600;font-size:18px;text-decoration:none;border-bottom:1px solid var(--line);}
      .mobile-nav a:last-child{border-bottom:0;}
      header.open .mobile-nav{display:block;}

      /* ---------- theme pull cord ---------- */
      .cord{
        position:fixed;top:0;right:14px;z-index:55;width:40px;
        display:flex;flex-direction:column;align-items:center;pointer-events:none;
      }
      .cord-swing{
        display:flex;flex-direction:column;align-items:center;
        transform-origin:top center;will-change:transform;
        transition:transform .55s cubic-bezier(.3,2.1,.45,1);
      }
      .cord.pulling .cord-swing{transform:translateY(13px);transition:transform .15s ease-in;}
      .cord-line{
        position:relative;width:3px;height:104px;pointer-events:auto;cursor:pointer;
        background:repeating-linear-gradient(48deg,#ddd6c4 0 3px,#a39a85 3px 6px);
        box-shadow:1px 1px 2px rgba(20,16,11,.3);
      }
      .cord-line::after{content:"";position:absolute;inset:0 -8px;}
      .cord-collar{
        width:12px;height:9px;margin-top:0;border-radius:2px;flex:none;
        background:linear-gradient(180deg,var(--brass-1),var(--brass-2));
        box-shadow:0 1px 3px rgba(20,16,11,.35);
      }
      .cord-handle{
        pointer-events:auto;cursor:pointer;border:0;padding:0;margin-top:1px;flex:none;
        width:23px;height:36px;border-radius:50% 50% 50% 50%/58% 58% 42% 42%;
        background:radial-gradient(circle at 36% 30%,#b9834c,#7c4f24 58%,#57350f);
        box-shadow:2px 4px 8px rgba(20,16,11,.4),inset 0 -5px 7px rgba(0,0,0,.3),inset 0 3px 4px rgba(255,235,200,.35);
        -webkit-tap-highlight-color:transparent;
      }
      .cord-handle:focus-visible{outline:2px solid var(--terra);outline-offset:3px;}

      /* ---------- hero ---------- */
      .hero{padding:clamp(120px,17vh,168px) 0 clamp(56px,8vh,84px);}
      .hero-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(32px,5vw,72px);align-items:center;}
      .avail{
        display:inline-flex;align-items:center;gap:9px;border:1px solid var(--line);
        background:var(--card);border-radius:999px;padding:8px 15px;
        font-family:var(--font-m);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);
      }
      .avail i{width:8px;height:8px;border-radius:50%;background:#5da24a;box-shadow:0 0 0 4px rgba(93,162,74,.18);}
      .hero h1{
        font-family:var(--font-d);font-weight:800;letter-spacing:-.035em;
        font-size:clamp(46px,7.2vw,92px);line-height:1.02;margin-top:26px;
      }
      .hero h1 .iam{display:block;color:var(--muted);}
      /* spiral notebook role card */
      .notebook{
        position:relative;margin-top:36px;max-width:600px;cursor:pointer;
        transform:rotate(-.5deg);perspective:1600px;perspective-origin:50% 38%;
        -webkit-tap-highlight-color:transparent;
      }
      .notebook .rings{
        position:absolute;top:-14px;left:22px;right:22px;z-index:3;
        display:flex;justify-content:space-between;pointer-events:none;
      }
      .notebook .rings i{
        width:11px;height:25px;border:3px solid #8f8a7d;border-radius:8px;
        background:linear-gradient(180deg,rgba(255,255,255,.65),rgba(0,0,0,.06));
        box-shadow:0 2px 3px rgba(23,20,15,.3);
      }
      .note-face{
        position:relative;border-radius:12px;color:#17140f;
        background:linear-gradient(180deg,#fffef9,#f6f1e3);
        padding:clamp(26px,4vw,38px) clamp(22px,4vw,36px) clamp(32px,4vw,42px);
        box-shadow:
          9px 11px 0 rgba(20,16,11,.92),
          0 3px 0 #f1ebdb,
          0 6px 0 #e9e2cd,
          0 26px 44px -18px rgba(23,20,15,.45),
          inset 0 0 0 1px rgba(23,20,15,.06);
        transform-origin:50% 0;backface-visibility:hidden;
        transform-style:preserve-3d;will-change:transform,box-shadow,filter;
      }
      /* page sheen that sweeps across while the page turns */
      .note-face::after{
        content:"";position:absolute;inset:0;border-radius:12px;pointer-events:none;
        background:linear-gradient(100deg,transparent 30%,rgba(255,255,255,.55) 50%,transparent 72%);
        background-size:260% 100%;background-position:130% 0;opacity:0;
      }
      .note-face.out::after{animation:noteSheen .8s cubic-bezier(.65,0,.35,1) both;}
      .note-face.in::after{animation:noteSheen .95s cubic-bezier(.65,0,.35,1) both;}
      @keyframes noteSheen{
        0%{background-position:130% 0;opacity:0;}
        50%{opacity:.7;}
        100%{background-position:-40% 0;opacity:0;}
      }
      html[data-theme="dark"] .note-face{
        box-shadow:
          9px 11px 0 rgba(0,0,0,.55),
          0 3px 0 #f1ebdb,
          0 6px 0 #e9e2cd,
          0 26px 44px -18px rgba(0,0,0,.85),
          inset 0 0 0 1px rgba(23,20,15,.06);
      }
      .note-title{
        display:block;font-family:var(--font-d);font-weight:800;letter-spacing:-.03em;
        font-size:clamp(30px,4.8vw,54px);line-height:1.08;
      }
      .note-count{
        position:absolute;right:20px;bottom:13px;
        font-family:var(--font-m);font-size:12px;letter-spacing:.12em;color:#8a8474;
        font-variant-numeric:tabular-nums;
      }
      .note-face.out{animation:noteOut .8s cubic-bezier(.55,.02,.85,.36) both;}
      .note-face.in{animation:noteIn .95s cubic-bezier(.16,.84,.3,1) both;}
      @keyframes noteOut{
        0%{transform:rotateX(0deg) translateZ(0px);
          box-shadow:9px 11px 0 rgba(20,16,11,.92),0 3px 0 #f1ebdb,0 6px 0 #e9e2cd,0 26px 44px -18px rgba(23,20,15,.45),inset 0 0 0 1px rgba(23,20,15,.06);
          filter:brightness(1);opacity:1;}
        100%{transform:rotateX(-90deg) translateZ(18px);
          box-shadow:24px 38px 0 rgba(20,16,11,.5),0 3px 0 #f1ebdb,0 6px 0 #e9e2cd,0 58px 68px -12px rgba(23,20,15,.48),inset 0 0 0 1px rgba(23,20,15,.06);
          filter:brightness(.84);opacity:.12;}
      }
      @keyframes noteIn{
        0%{transform:rotateX(90deg) translateZ(18px);opacity:.12;
          box-shadow:24px 38px 0 rgba(20,16,11,.5),0 3px 0 #f1ebdb,0 6px 0 #e9e2cd,0 58px 68px -12px rgba(23,20,15,.48),inset 0 0 0 1px rgba(23,20,15,.06);
          filter:brightness(.84);}
        100%{transform:rotateX(0deg) translateZ(0px);opacity:1;
          box-shadow:9px 11px 0 rgba(20,16,11,.92),0 3px 0 #f1ebdb,0 6px 0 #e9e2cd,0 26px 44px -18px rgba(23,20,15,.45),inset 0 0 0 1px rgba(23,20,15,.06);
          filter:brightness(1);}
      }
      .note-hint{
        margin-top:20px;font-family:var(--font-m);font-size:11.5px;
        letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
      }
      .hero p.lede{margin-top:24px;max-width:52ch;font-size:17.5px;color:var(--ink-soft);}
      .hero p.lede b{color:var(--ink);font-weight:600;}
      .cta-row{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px;}
      .btn{
        display:inline-flex;align-items:center;gap:12px;min-height:52px;
        padding:8px 8px 8px 24px;border-radius:999px;text-decoration:none;
        font-family:var(--font-d);font-weight:600;font-size:16px;
        transition:transform .25s ease,background .25s ease,color .25s ease;
      }
      .btn .arr{
        width:38px;height:38px;border-radius:50%;display:grid;place-items:center;flex:none;
        transition:transform .25s ease;
      }
      .btn:hover .arr{transform:translateX(3px);}
      .btn-dark{background:var(--ink);color:var(--paper);}
      .btn-dark .arr{background:var(--paper);color:var(--ink);}
      .btn-ghost{border:1px solid var(--ink);color:var(--ink);padding-right:24px;}
      .btn-ghost:hover{background:var(--ink);color:var(--paper);}
      /* portrait — arched like the doors */
      .portrait{justify-self:end;width:min(100%,360px);}
      .portrait .arch{
        border-radius:190px 190px 22px 22px;background:#fff;padding:13px 13px 0;
        box-shadow:0 24px 50px -22px rgba(23,20,15,.28),inset 0 0 0 1px var(--line);
      }
      .portrait .arch-in{
        border-radius:178px 178px 14px 14px;background:var(--paper-2);
        aspect-ratio:3/3.9;overflow:hidden;position:relative;
      }
      .portrait .arch-in img{
        position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 12%;
        transition:transform .6s cubic-bezier(.22,.8,.3,1);
      }
      /* colour portrait layered over the black-and-white one — crossfades in on hover / focus / tap */
      .portrait .arch-in img.photo-color{
        opacity:0;pointer-events:none;
        transition:opacity .6s ease,transform .6s cubic-bezier(.22,.8,.3,1);
      }
      .portrait:hover .arch-in img.photo-color,
      .portrait:focus-within .arch-in img.photo-color,
      .portrait .arch-in.color-on img.photo-color{opacity:1;}
      .portrait:hover .arch-in img,
      .portrait:focus-within .arch-in img,
      .portrait .arch-in.color-on img{transform:scale(1.035);}
      .portrait .arch-in::after{
        content:"";position:absolute;inset:14px;border:1px solid rgba(255,255,255,.35);
        border-radius:170px 170px 10px 10px;pointer-events:none;
      }
      .portrait figcaption{
        display:flex;justify-content:space-between;gap:10px;padding:16px 4px 2px;
        font-family:var(--font-m);font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);
      }
      .portrait .arch{transition:transform .5s cubic-bezier(.22,.8,.3,1),box-shadow .5s ease;}
      .portrait .arch-in{cursor:pointer;}
      .portrait:hover .arch,.portrait:focus-within .arch{transform:translateY(-6px);}
      .portrait .arch-in:focus-visible{outline:2px solid var(--navy);outline-offset:4px;}
      .portrait-hint{
        margin-top:10px;text-align:center;cursor:pointer;
        font-family:var(--font-m);font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
        transition:color .25s ease;
      }
      .portrait-hint b{color:var(--terra);font-weight:500;}
      .portrait:hover .portrait-hint{color:var(--ink);}
      .hero-strip{
        margin-top:clamp(48px,7vh,72px);border-top:1px solid var(--line);padding-top:20px;
        display:flex;flex-wrap:wrap;gap:10px 26px;
        font-family:var(--font-m);font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);
      }
      .hero-strip span{display:flex;align-items:center;gap:26px;}
      .hero-strip span::after{content:"·";color:var(--terra);font-weight:700;}
      .hero-strip span:last-child::after{content:"";}

      /* ---------- ability card ---------- */
      .ability{padding:clamp(64px,10vh,110px) 0;}
      .ability-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(36px,6vw,90px);align-items:center;}
      h2.big{
        font-family:var(--font-d);font-weight:800;letter-spacing:-.03em;
        font-size:clamp(36px,4.6vw,58px);line-height:1.05;margin-top:18px;
      }
      .ability-copy p{margin-top:20px;color:var(--ink-soft);font-size:17px;max-width:46ch;}
      .hint{
        margin-top:26px;display:inline-flex;align-items:center;gap:10px;max-width:100%;
        font-family:var(--font-m);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
      }
      .hint span{min-width:0;}
      .hint svg{width:18px;height:18px;flex:none;}
      .stage{perspective:1200px;display:flex;justify-content:center;padding:18px 0;width:100%;min-width:0;}
      .acard{
        width:min(350px,100%);background:var(--card);border:1px solid var(--line);
        border-radius:26px;padding:26px 26px 22px;cursor:grab;touch-action:none;
        box-shadow:0 34px 60px -28px rgba(23,20,15,.35);
        transform-style:preserve-3d;will-change:transform;user-select:none;-webkit-user-select:none;
        position:relative;overflow:hidden;
      }
      .acard.grabbing{cursor:grabbing;}
      .acard .glare{
        position:absolute;inset:0;border-radius:26px;pointer-events:none;opacity:0;transition:opacity .3s;
        background:radial-gradient(420px circle at var(--gx,50%) var(--gy,50%),rgba(255,255,255,.5),transparent 65%);
      }
      .acard:hover .glare{opacity:.55;}
      .acard-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;}
      .acard-top .who{display:flex;gap:14px;align-items:center;min-width:0;}
      .acard-top .who>div{min-width:0;}
      .avatar{
        width:56px;height:56px;border-radius:50%;background:var(--navy);color:#f4f1ea;
        display:grid;place-items:center;font-family:var(--font-d);font-weight:800;font-size:20px;flex:none;
      }
      .acard h3{font-family:var(--font-d);font-weight:700;font-size:21px;letter-spacing:-.01em;line-height:1.15;}
      .acard .sub{font-size:13.5px;color:var(--muted);margin-top:2px;}
      .chip{
        font-family:var(--font-m);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;
        border:1px solid var(--line);border-radius:999px;padding:6px 11px;color:var(--ink-soft);white-space:nowrap;
      }
      .acard .rule{height:1px;background:var(--line);margin:22px 0 6px;}
      .skill{padding:11px 0 3px;}
      .skill .row{display:flex;justify-content:space-between;align-items:baseline;}
      .skill .name{font-family:var(--font-d);font-weight:600;font-size:16.5px;}
      .skill .score{font-family:var(--font-m);font-size:14px;color:var(--muted);font-variant-numeric:tabular-nums;}
      .skill .score b{color:var(--ink);font-size:17px;}
      .track{height:8px;border-radius:99px;background:var(--paper-2);margin-top:9px;overflow:hidden;}
      .fill{height:100%;width:var(--w);border-radius:99px;background:var(--c,var(--navy));}
      .js .fill{transform:scaleX(0);transform-origin:left;transition:transform 1.1s cubic-bezier(.22,.8,.3,1) .15s;}
      .js .in .fill{transform:scaleX(1);}
      .acard-foot{
        margin-top:22px;padding-top:16px;border-top:1px solid var(--line);
        display:flex;justify-content:space-between;gap:10px;
        font-family:var(--font-m);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);
      }

      /* ---------- work / doors ---------- */
      .work{
        position:relative;overflow:hidden;color:#f2eee6;
        padding:clamp(72px,11vh,120px) 0 clamp(104px,14vh,150px);
        background:
          radial-gradient(1100px 520px at 50% -8%,#2b251d 0%,transparent 62%),
          linear-gradient(180deg,#1d1a16 0%,#171410 78%,#14110d 100%);
      }
      .work::after{
        content:"";position:absolute;left:0;right:0;bottom:0;height:30px;pointer-events:none;
        background:
          radial-gradient(rgba(242,238,230,.13) 1.1px,transparent 1.4px) 0 7px/22px 22px,
          linear-gradient(180deg,#0d0b08,#0a0806);
        border-top:10px solid #282219;
        box-shadow:0 -1px 0 rgba(0,0,0,.65),inset 0 1px 0 rgba(242,238,230,.06);
      }
      .work-head{text-align:center;}
      .work .label{color:rgba(242,238,230,.55);justify-content:center;}
      .work .label::before{background:var(--brass-2);}
      .work h2.big{
        color:#f5f1e8;margin-top:16px;
        font-size:clamp(34px,5.4vw,64px);
      }
      .work-hint{
        margin-top:16px;font-family:var(--font-m);font-size:12px;
        letter-spacing:.12em;text-transform:uppercase;color:rgba(242,238,230,.55);
      }
      .doors{
        margin-top:clamp(42px,6vh,62px);display:flex;flex-wrap:wrap;
        justify-content:center;gap:clamp(38px,6vw,88px);
      }
      .door-unit{width:min(330px,86vw);}
      .doorway{position:relative;aspect-ratio:3/4.35;perspective:1300px;}
      .doorway.is-open{z-index:5;}
      /* dark architrave frame */
      .doorway::before{
        content:"";position:absolute;inset:0;border-radius:999px 999px 12px 12px;
        background:linear-gradient(180deg,#3d372d,#26211a 55%,#1c1813);
        box-shadow:
          inset 0 0 0 2px rgba(0,0,0,.55),
          inset 0 0 0 5px rgba(242,238,230,.05),
          inset 0 -14px 22px rgba(0,0,0,.5),
          0 34px 50px -24px rgba(0,0,0,.75);
      }
      /* the room inside the door */
      .door-inside{
        position:absolute;inset:13px;border-radius:999px 999px 7px 7px;overflow:hidden;
        background:#12100c;display:flex;flex-direction:column;
        box-shadow:inset 0 0 0 1px rgba(0,0,0,.7),inset 0 0 64px rgba(255,190,100,.13);
        transition:filter .8s ease;
      }
      /* until fully open the project inside is only peeking — dimmed and not interactive */
      .doorway:not(.is-open) .door-inside{filter:brightness(.55);pointer-events:none;}
      .door-inside img{width:100%;height:39%;flex:none;object-fit:cover;object-position:top center;}
      .inside-body{flex:1;min-height:0;display:flex;flex-direction:column;padding:15px 18px 17px;}
      .inside-body h3{font-family:var(--font-d);font-weight:700;font-size:19.5px;letter-spacing:-.01em;line-height:1.2;}
      .inside-body p{margin-top:7px;font-size:13.5px;line-height:1.5;color:rgba(242,238,230,.74);}
      .inside-actions{margin-top:auto;padding-top:12px;display:flex;flex-direction:column;gap:9px;}
      .open-project{
        display:flex;align-items:center;justify-content:center;gap:9px;text-decoration:none;
        background:linear-gradient(180deg,var(--brass-1),var(--brass-2));color:#3a2c07;
        font-family:var(--font-d);font-weight:700;font-size:14.5px;
        border-radius:999px;padding:11px 16px;
        box-shadow:0 6px 16px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.6);
        transition:filter .25s ease;
      }
      .open-project:hover{filter:brightness(1.07);}
      .door-close{
        appearance:none;-webkit-appearance:none;cursor:pointer;
        background:transparent;border:1px solid rgba(242,238,230,.35);color:#f2eee6;
        font-family:var(--font-b);font-size:13.5px;font-weight:500;
        border-radius:999px;padding:9px 16px;transition:background .25s ease,border-color .25s ease;
      }
      .door-close:hover{background:rgba(242,238,230,.1);border-color:rgba(242,238,230,.6);}
      /* the swinging ribbed leaf */
      .door-leaf{
        appearance:none;-webkit-appearance:none;display:block;cursor:pointer;
        position:absolute;inset:13px;z-index:3;margin:0;padding:0;text-align:center;
        border:0;border-radius:999px 999px 7px 7px;color:#fff;
        transform-origin:left center;backface-visibility:hidden;
        transition:transform .85s cubic-bezier(.3,.75,.3,1),box-shadow .85s ease;
        box-shadow:
          inset 0 0 0 1px rgba(0,0,0,.4),
          inset 0 -20px 32px rgba(0,0,0,.28),
          inset 0 10px 22px rgba(255,255,255,.05);
        -webkit-tap-highlight-color:transparent;
      }
      .door-leaf::before{
        content:"";position:absolute;inset:15px 15px 13px;border-radius:999px 999px 5px 5px;
        background:repeating-linear-gradient(90deg,rgba(0,0,0,.22) 0 2px,rgba(255,255,255,.055) 2px 4px,rgba(0,0,0,0) 4px 11px);
        box-shadow:
          inset 0 0 0 1px rgba(0,0,0,.28),
          inset 0 3px 12px rgba(0,0,0,.38),
          inset 0 -8px 16px rgba(0,0,0,.22);
      }
      .leaf-navy{background:linear-gradient(180deg,#2a4066,#1e2d4a 68%,#182640);}
      .leaf-sage{background:linear-gradient(180deg,#8b9a83,#74836c 68%,#637258);}
      .doorway:not(.is-open):not(.is-half) .door-leaf:hover{transform:rotateY(-13deg);}
      .doorway:not(.is-open):not(.is-half) .door-leaf:focus-visible{transform:rotateY(-13deg);outline:2px solid var(--brass-1);outline-offset:4px;}
      .doorway.is-half{z-index:4;}
      .doorway.is-half .door-leaf{
        transform:rotateY(-46deg);
        box-shadow:8px 0 26px rgba(0,0,0,.5),inset 0 0 0 1px rgba(0,0,0,.4),inset 0 -20px 32px rgba(0,0,0,.28),inset 0 10px 22px rgba(255,255,255,.05);
      }
      .doorway.is-open .door-leaf{
        transform:rotateY(-88deg);pointer-events:none;
        box-shadow:14px 0 34px rgba(0,0,0,.45),inset 0 0 0 1px rgba(0,0,0,.4);
      }
      /* ---------- project listing page (opened from a door) ---------- */
      .project-room[hidden]{display:none;}
      .project-room{
        position:fixed;inset:0;z-index:180;overflow-y:auto;overflow-x:hidden;
        color:#f2eee6;
        background:
          radial-gradient(1100px 560px at 50% -10%,#2b251d 0%,transparent 62%),
          linear-gradient(180deg,#1d1a16 0%,#14110d 100%);
      }
      .room-bar{
        position:relative;z-index:3;max-width:1120px;width:100%;margin:0 auto;
        display:flex;align-items:center;justify-content:space-between;gap:14px;
        padding:20px clamp(16px,4vw,28px) 0;box-sizing:border-box;
      }
      .room-back,.room-close{
        appearance:none;-webkit-appearance:none;cursor:pointer;
        display:inline-flex;align-items:center;gap:9px;
        background:rgba(242,238,230,.06);border:1px solid rgba(242,238,230,.35);color:#f2eee6;
        font-family:var(--font-b);font-size:14.5px;font-weight:600;
        border-radius:999px;padding:11px 20px;
        transition:background .25s ease,border-color .25s ease;
      }
      .room-back:hover,.room-close:hover{background:rgba(242,238,230,.14);border-color:rgba(242,238,230,.65);}
      .room-close .x{font-size:18px;line-height:1;font-weight:400;}
      .room-center{
        position:relative;z-index:2;max-width:1120px;width:100%;margin:0 auto;box-sizing:border-box;
        padding:clamp(18px,3.5vh,34px) clamp(16px,4vw,28px) clamp(40px,6vh,64px);
        perspective:1300px;
      }
      /* responsive card grid — add more .project-card items here and they wrap:
         1 column on phone, multiple columns on wider screens */
      .project-grid{
        display:grid;
        grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr));
        gap:22px;align-items:stretch;
      }
      .project-card{
        display:flex;flex-direction:column;height:100%;
        border-radius:20px;overflow:hidden;
        background:linear-gradient(180deg,#23201a,#16130f);
        border:1px solid rgba(242,238,230,.16);
        box-shadow:0 30px 60px -24px rgba(0,0,0,.8),inset 0 1px 0 rgba(242,238,230,.07);
      }
      .project-card-media{background:#0d0b08;flex:none;}
      .project-card-media img{width:100%;aspect-ratio:16/9;object-fit:cover;object-position:top center;display:block;}
      .project-card-body{padding:22px 22px 24px;display:flex;flex-direction:column;flex:1;min-height:0;}
      .room-eyebrow,.project-card-cat{
        font-family:var(--font-m);font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;
        color:var(--brass-1);
      }
      .project-card-body h3{
        font-family:var(--font-d);font-weight:800;letter-spacing:-.02em;
        font-size:clamp(23px,3vw,27px);line-height:1.12;margin-top:9px;
      }
      .room-desc,.project-card-desc{margin-top:11px;font-size:15.5px;line-height:1.6;color:rgba(242,238,230,.86);}
      .room-tech,.project-card-tech{
        margin-top:12px;font-family:var(--font-m);font-size:13px;letter-spacing:.05em;
        color:rgba(242,238,230,.6);
      }
      .room-tech b,.project-card-tech b{color:var(--brass-1);font-weight:500;}
      .project-card-actions{margin-top:auto;padding-top:22px;display:flex;}
      .project-card-actions .open-project{padding:12px 22px;font-size:15px;flex:1;}
      .room-foot-actions{margin-top:26px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;}
      .room-foot-actions .door-close{padding:12px 20px;font-size:14.5px;}
      @media (max-width:560px){
        .project-grid{grid-template-columns:1fr;gap:18px;}
        .project-card-actions .open-project{width:100%;justify-content:center;}
        .room-back,.room-close{padding:10px 16px;font-size:13.5px;}
      }
      .plate{
        position:absolute;z-index:2;top:32%;left:50%;transform:translateX(-50%);
        background:linear-gradient(180deg,#f3dd8f,var(--brass-1) 45%,var(--brass-2));
        color:#3a2c07;font-family:var(--font-d);font-weight:700;text-align:center;
        font-size:13.5px;letter-spacing:.16em;text-transform:uppercase;line-height:1.4;
        padding:11px 24px;border-radius:4px;max-width:82%;
        box-shadow:0 7px 18px rgba(10,8,4,.5),inset 0 1px 0 rgba(255,255,255,.75),inset 0 -2px 4px rgba(120,84,10,.35);
      }
      .plate::before,.plate::after{content:"";position:absolute;top:50%;width:5px;height:5px;border-radius:50%;background:rgba(58,44,7,.55);transform:translateY(-50%);}
      .plate::before{left:8px;}.plate::after{right:8px;}
      .handle{
        position:absolute;z-index:2;right:27px;top:60%;width:52px;height:13px;border-radius:8px;
        background:linear-gradient(180deg,#f3dd8f,var(--brass-2));
        box-shadow:0 4px 10px rgba(10,8,4,.5),inset 0 1px 0 rgba(255,255,255,.7);
      }
      .handle::before{content:"";position:absolute;right:-7px;top:50%;transform:translateY(-50%);width:19px;height:19px;border-radius:50%;background:radial-gradient(circle at 36% 32%,#f6e294,var(--brass-2) 70%,#9a741f);box-shadow:0 3px 8px rgba(10,8,4,.45);}
      .keyhole{position:absolute;z-index:2;right:45px;top:calc(60% + 27px);width:11px;height:17px;border-radius:6px;background:linear-gradient(180deg,#f3dd8f,var(--brass-2));box-shadow:0 3px 7px rgba(10,8,4,.45);}
      .keyhole::after{content:"";position:absolute;left:50%;top:4px;transform:translateX(-50%);width:4px;height:8px;border-radius:3px;background:rgba(40,30,4,.8);}
      .leaf-hint{
        position:absolute;z-index:2;left:0;right:0;bottom:20px;
        font-family:var(--font-m);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
        color:rgba(255,255,255,.78);
      }
      .door-about{margin-top:20px;text-align:center;}
      .door-about-line{
        font-size:15px;line-height:1.55;color:rgba(242,238,230,.86);
        max-width:34ch;margin:0 auto;
      }
      .door-tech{
        margin-top:9px;font-family:var(--font-m);font-size:12px;letter-spacing:.06em;
        color:rgba(242,238,230,.55);
      }
      .door-tech b{color:var(--brass-1);font-weight:500;}

      /* ---------- story ---------- */
      .story{padding:clamp(64px,10vh,110px) 0 clamp(80px,12vh,130px);}
      .story-grid{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(36px,6vw,90px);}
      .story-side{position:sticky;top:110px;align-self:start;}
      .story-side .year{
        font-family:var(--font-d);font-weight:800;letter-spacing:-.04em;
        font-size:clamp(90px,11vw,168px);line-height:1;margin-top:14px;color:var(--ink);
      }
      .story-side .count{margin-top:22px;display:flex;align-items:center;gap:16px;font-family:var(--font-m);font-size:13.5px;color:var(--muted);}
      .story-side .count b{color:var(--ink);}
      .story-side .barline{width:150px;height:2px;background:var(--line);position:relative;overflow:hidden;}
      .story-side .barline i{position:absolute;inset:0;background:var(--ink);transform-origin:left;transform:scaleX(0);transition:transform .3s linear;}
      .timeline{position:relative;padding-left:34px;}
      .timeline::before{content:"";position:absolute;left:6px;top:8px;bottom:8px;width:2px;background:var(--line);}
      .timeline .prog{position:absolute;left:6px;top:8px;width:2px;background:var(--ink);height:0;}
      .entry{position:relative;padding:6px 0 52px;}
      .entry:last-child{padding-bottom:6px;}
      .entry::before{
        content:"";position:absolute;left:-34px;top:10px;width:14px;height:14px;border-radius:50%;
        background:var(--paper);border:2px solid var(--muted);transition:background .3s,border-color .3s;
      }
      .entry.lit::before{background:var(--ink);border-color:var(--ink);}
      .entry .when{font-family:var(--font-m);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);}
      .entry h3{font-family:var(--font-d);font-weight:700;font-size:clamp(25px,3vw,33px);letter-spacing:-.02em;margin-top:10px;}
      .entry .org{font-weight:600;color:var(--ink-soft);margin-top:4px;font-size:16.5px;}
      .entry ul{margin-top:14px;display:grid;gap:9px;}
      .entry ul li{position:relative;padding-left:20px;color:var(--ink-soft);font-size:16px;max-width:56ch;}
      .entry ul li::before{content:"–";position:absolute;left:0;color:var(--muted);}
      .entry .photos{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px;max-width:520px;}
      .entry .photos figure{border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#fff;}
      .entry .photos img{width:100%;height:230px;object-fit:cover;}
      .entry .photos figcaption{padding:10px 14px;font-size:12.5px;color:var(--muted);font-family:var(--font-m);letter-spacing:.04em;}
      .entry .shows{display:grid;grid-template-columns:1fr;gap:14px;margin-top:22px;max-width:640px;}
      .entry .shows figure{border-radius:16px;overflow:hidden;border:1px solid var(--line);background:#fff;}
      .entry .shows img{width:100%;height:auto;}
      .entry .shows figcaption{padding:10px 14px;font-size:12.5px;color:var(--muted);font-family:var(--font-m);letter-spacing:.04em;}

      /* ---------- contact / footer ---------- */
      .contact{background:var(--dark);color:#f2eee6;border-radius:34px 34px 0 0;padding:clamp(64px,10vh,110px) 0 0;margin-top:10px;}
      .contact .label{color:rgba(242,238,230,.55);}
      .contact .label::before{background:#5da24a;}
      .contact h2{
        font-family:var(--font-d);font-weight:800;letter-spacing:-.035em;
        font-size:clamp(42px,6.4vw,84px);line-height:1.04;margin-top:24px;
      }
      .contact h2 .dim{color:rgba(242,238,230,.42);}
      .contact p.lede{margin-top:24px;max-width:50ch;font-size:17.5px;color:rgba(242,238,230,.78);}
      .contact .cta-row{margin-top:36px;}
      .btn-light{background:#f2eee6;color:var(--dark);}
      .btn-light .arr{background:var(--dark);color:#f2eee6;}
      .btn-outline{border:1px solid rgba(242,238,230,.4);color:#f2eee6;padding-right:24px;}
      .btn-outline:hover{background:#f2eee6;color:var(--dark);}
      .foot{
        margin-top:clamp(56px,9vh,90px);border-top:1px solid rgba(242,238,230,.15);
        padding:38px 0 30px;display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:34px;
      }
      .foot h4{font-family:var(--font-m);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:rgba(242,238,230,.45);margin:0 0 16px;font-weight:500;}
      .foot a{display:block;text-decoration:none;padding:5px 0;color:rgba(242,238,230,.88);font-size:15.5px;width:fit-content;}
      .foot a:hover{text-decoration:underline;text-underline-offset:4px;}
      .foot .stat p{padding:5px 0;color:rgba(242,238,230,.88);font-size:15.5px;margin:0;}
      .foot .stat p b{font-weight:600;font-variant-numeric:tabular-nums;}
      .legal{
        border-top:1px solid rgba(242,238,230,.15);padding:20px 0 26px;
        display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;
        font-size:13.5px;color:rgba(242,238,230,.55);
      }
      .legal button{background:none;border:0;color:inherit;font:inherit;cursor:pointer;padding:4px 0;}
      .legal button:hover{color:#f2eee6;}

      /* ---------- ability card modal (ornate trading card) ---------- */
      .amodal[hidden]{display:none;}
      .amodal{
        position:fixed;inset:0;z-index:200;overflow-y:auto;overflow-x:hidden;
        background:radial-gradient(1100px 750px at 50% 42%,#2b1d0f 0%,#160f08 48%,#090503 100%);
        color:#f5ecd7;
      }
      .amodal .particles{position:fixed;inset:0;pointer-events:none;overflow:hidden;}
      .amodal .particle{
        position:absolute;border-radius:50%;background:#ffb85c;
        box-shadow:0 0 7px 2px rgba(255,170,60,.55),0 0 18px 4px rgba(255,150,40,.18);
        animation:twinkle 3.4s ease-in-out infinite;
      }
      @keyframes twinkle{0%,100%{opacity:.25;}50%{opacity:.95;}}
      .amodal-head{
        position:relative;z-index:3;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;
        padding:26px clamp(20px,4vw,44px) 6px;max-width:1400px;margin:0 auto;
      }
      .amodal-name{font-family:var(--font-b);font-weight:500;font-size:15px;letter-spacing:.42em;color:#e9dcc0;}
      .amodal-sub{margin-top:9px;font-size:15px;font-style:italic;color:rgba(245,236,215,.62);}
      .amodal-close{
        flex:none;display:inline-flex;align-items:center;gap:9px;cursor:pointer;
        border:1px solid rgba(245,236,215,.4);background:rgba(255,255,255,.05);color:#fff;
        border-radius:999px;padding:11px 20px;font-family:var(--font-b);font-size:14.5px;font-weight:500;
        transition:background .25s ease,border-color .25s ease;
      }
      .amodal-close:hover{background:rgba(255,255,255,.14);border-color:rgba(245,236,215,.75);}
      .amodal-close .x{font-size:17px;line-height:1;font-weight:400;}
      .amodal-center{
        position:relative;z-index:2;min-height:calc(100% - 92px);
        display:grid;place-items:center;padding:22px 16px 52px;perspective:1300px;
      }
      @property --aura-a{syntax:'<angle>';initial-value:0deg;inherits:false;}
      .acard2-wrap{position:relative;transform-style:preserve-3d;will-change:transform;width:min(432px,100%);cursor:grab;touch-action:pan-y;}
      .acard2-wrap.dragging{cursor:grabbing;}
      /* glowing animated gold aura / border halo around the card */
      .acard2-wrap::before{
        content:"";position:absolute;inset:-9px;border-radius:30px;z-index:0;pointer-events:none;
        background:conic-gradient(from var(--aura-a),rgba(255,196,64,.0) 0deg,#f6d47c 55deg,rgba(255,170,40,.15) 115deg,#ffe9a8 180deg,rgba(255,196,64,.05) 245deg,#c9962e 310deg,rgba(255,196,64,0) 360deg);
        filter:blur(13px);opacity:.62;
        animation:auraSpin 7s linear infinite,auraPulse 3.4s ease-in-out infinite alternate;
      }
      .acard2-wrap::after{
        content:"";position:absolute;inset:-3px;border-radius:23px;z-index:0;pointer-events:none;
        background:conic-gradient(from var(--aura-a),transparent 0deg,rgba(255,232,160,.85) 60deg,transparent 130deg,rgba(255,205,90,.7) 210deg,transparent 285deg,rgba(255,232,160,.85) 340deg,transparent 360deg);
        -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;
        padding:3px;opacity:.85;
        animation:auraSpin 7s linear infinite;
      }
      @keyframes auraSpin{to{--aura-a:360deg;}}
      @keyframes auraPulse{from{opacity:.42;}to{opacity:.78;}}
      .amodal.open .acard2-wrap{animation:cardIn .5s cubic-bezier(.22,.9,.3,1) backwards;}
      @keyframes cardIn{from{opacity:0;transform:scale(.93) translateY(16px);}to{opacity:1;transform:scale(1) translateY(0);}}
      /* gentle idle float / sway on the card itself, under the pointer tilt on the wrap */
      .acard2-float{animation:cardFloat 6.5s ease-in-out infinite;will-change:transform;}
      @keyframes cardFloat{
        0%,100%{transform:translateY(-5px) rotate(-.45deg);}
        30%{transform:translateY(2px) rotate(.25deg);}
        55%{transform:translateY(6px) rotate(.45deg);}
        78%{transform:translateY(0px) rotate(-.2deg);}
      }
      /* moving shine that follows the pointer across the card */
      .acard2-glare{
        position:absolute;inset:0;z-index:6;border-radius:16px;pointer-events:none;
        opacity:0;transition:opacity .45s ease;mix-blend-mode:screen;
        background:radial-gradient(340px circle at var(--gx,50%) var(--gy,50%),rgba(255,242,205,.38),rgba(255,242,205,.1) 42%,transparent 68%);
      }
      .acard2-wrap.tilting .acard2-glare{opacity:1;}
      .acard2{
        position:relative;z-index:1;border-radius:18px;padding:24px 21px 19px;
        background:linear-gradient(165deg,#cda0a8 0%,#b0828d 42%,#96707e 78%,#8a6472 100%);
        border:3px solid #c9a227;
        box-shadow:
          inset 0 0 0 2px #7c5518,
          inset 0 0 0 5px #ecd27c,
          inset 0 0 0 7px rgba(124,85,24,.65),
          inset 0 0 42px rgba(70,35,45,.35),
          0 44px 84px -18px rgba(0,0,0,.75),
          0 0 70px rgba(255,180,60,.14);
        animation:goldGlow 3.4s ease-in-out infinite alternate;
      }
      @keyframes goldGlow{
        from{box-shadow:inset 0 0 0 2px #7c5518,inset 0 0 0 5px #ecd27c,inset 0 0 0 7px rgba(124,85,24,.65),inset 0 0 42px rgba(70,35,45,.35),0 44px 84px -18px rgba(0,0,0,.75),0 0 46px rgba(255,180,60,.16),0 0 14px rgba(255,205,90,.18);}
        to{box-shadow:inset 0 0 0 2px #7c5518,inset 0 0 0 5px #f4dd8e,inset 0 0 0 7px rgba(124,85,24,.65),inset 0 0 42px rgba(70,35,45,.35),0 44px 84px -18px rgba(0,0,0,.75),0 0 96px rgba(255,180,60,.36),0 0 28px rgba(255,205,90,.38);}
      }
      /* holographic foil — prismatic layer that follows the pointer */
      .acard2-holo{
        position:absolute;inset:0;z-index:7;border-radius:16px;pointer-events:none;
        opacity:0;transition:opacity .45s ease;mix-blend-mode:color-dodge;
        background:
          radial-gradient(430px circle at var(--gx,50%) var(--gy,50%),rgba(255,255,255,.5),rgba(255,255,255,.08) 42%,transparent 68%),
          linear-gradient(var(--holo-angle,115deg),rgba(255,0,110,.34) 0%,rgba(255,170,0,.38) 18%,rgba(240,255,0,.30) 34%,rgba(0,235,170,.34) 50%,rgba(0,150,255,.38) 66%,rgba(165,0,255,.34) 82%,rgba(255,0,110,.30) 100%);
        background-size:100% 100%,280% 280%;
        background-position:0 0,var(--holo-pos,50%) 50%;
        filter:saturate(1.35);
      }
      .acard2-wrap.tilting .acard2-holo{opacity:.5;}
      .acard2-holo::after{
        content:"";position:absolute;inset:0;border-radius:16px;
        background:repeating-linear-gradient(112deg,rgba(255,255,255,.14) 0 1px,transparent 1px 7px);
        mix-blend-mode:overlay;opacity:.6;
      }
      /* diagonal shine that periodically sweeps across the foil */
      .acard2-shine{
        position:absolute;inset:0;z-index:8;border-radius:16px;pointer-events:none;overflow:hidden;
        mix-blend-mode:screen;opacity:.55;
        background:linear-gradient(105deg,transparent 32%,rgba(255,250,220,.5) 48%,rgba(255,255,255,.14) 54%,transparent 68%);
        background-size:280% 100%;background-position:135% 0;
        animation:holoSweep 5.6s ease-in-out infinite;
      }
      @keyframes holoSweep{
        0%,58%,100%{background-position:135% 0;opacity:0;}
        68%{opacity:.6;}
        84%{background-position:-45% 0;opacity:.45;}
        92%{opacity:0;}
      }
      /* sparkle particles clustered around the card edges */
      .acard2-sparkles{position:absolute;inset:-14px;z-index:9;pointer-events:none;}
      .acard2-sparkles .sparkle{
        position:absolute;display:block;background:linear-gradient(180deg,#fff6cf,#f3c74f);
        clip-path:polygon(50% 0%,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0% 50%,38% 38%);
        filter:drop-shadow(0 0 5px rgba(255,200,80,.9));
        opacity:0;transform:scale(.2) rotate(0deg);
        animation:sparklePop 3.8s ease-in-out infinite;
      }
      @keyframes sparklePop{
        0%,100%{opacity:0;transform:scale(.2) rotate(0deg);}
        12%{opacity:1;transform:scale(1) rotate(72deg);}
        26%{opacity:.15;transform:scale(.45) rotate(130deg);}
        42%{opacity:.95;transform:scale(.85) rotate(200deg);}
        58%,92%{opacity:0;transform:scale(.25) rotate(280deg);}
      }
      /* ornate gold corners */
      .orn{position:absolute;width:52px;height:52px;z-index:5;pointer-events:none;}
      .orn::before{
        content:"";position:absolute;inset:0;
        border:0 solid #e9c766;
      }
      .orn::after{
        content:"";position:absolute;width:9px;height:9px;border-radius:50%;
        background:radial-gradient(circle at 35% 35%,#e06666,#7a1622 70%);
        box-shadow:0 0 0 2px #8a5a14,0 0 6px rgba(0,0,0,.4);
      }
      .orn i{position:absolute;width:22px;height:22px;border-radius:50%;border:2px solid rgba(233,199,102,.9);}
      .orn.tl{top:5px;left:5px;}
      .orn.tl::before{border-top-width:3px;border-left-width:3px;border-top-left-radius:14px;}
      .orn.tl::after{top:5px;left:5px;}
      .orn.tl i{top:11px;left:11px;border-right:0;border-bottom:0;}
      .orn.tr{top:5px;right:5px;}
      .orn.tr::before{border-top-width:3px;border-right-width:3px;border-top-right-radius:14px;}
      .orn.tr::after{top:5px;right:5px;}
      .orn.tr i{top:11px;right:11px;border-left:0;border-bottom:0;}
      .orn.bl{bottom:5px;left:5px;}
      .orn.bl::before{border-bottom-width:3px;border-left-width:3px;border-bottom-left-radius:14px;}
      .orn.bl::after{bottom:5px;left:5px;}
      .orn.bl i{bottom:11px;left:11px;border-right:0;border-top:0;}
      .orn.br{bottom:5px;right:5px;}
      .orn.br::before{border-bottom-width:3px;border-right-width:3px;border-bottom-right-radius:14px;}
      .orn.br::after{bottom:5px;right:5px;}
      .orn.br i{bottom:11px;right:11px;border-left:0;border-top:0;}
      .acard2-name{
        position:relative;text-align:center;margin:4px 12px 17px;
        background:linear-gradient(180deg,#fdf6e0,#efdfba);
        border:2px solid #a87c1e;border-radius:9px;
        box-shadow:inset 0 0 0 2px rgba(255,255,255,.55),inset 0 -8px 14px rgba(168,124,30,.18),0 3px 8px rgba(60,30,10,.3);
        padding:11px 14px;
        font-family:var(--font-d);font-weight:800;font-size:clamp(23px,6vw,27px);letter-spacing:.01em;color:#1d1710;
      }
      .acard2-name::before,.acard2-name::after{
        content:"";position:absolute;top:50%;width:8px;height:8px;transform:translateY(-50%) rotate(45deg);
        background:#b8862e;box-shadow:0 0 0 2px #f3d98b;
      }
      .acard2-name::before{left:12px;}
      .acard2-name::after{right:12px;}
      .acard2-photo{
        position:relative;margin:0 5px;border-radius:7px;overflow:hidden;
        border:3px solid #c9a227;outline:2px solid #7c5518;outline-offset:2px;
        box-shadow:0 8px 20px rgba(50,20,20,.35);
      }
      .acard2-photo img{width:100%;aspect-ratio:4/3.1;object-fit:cover;object-position:50% 14%;transition:transform .6s cubic-bezier(.22,.8,.3,1);}
      /* colour portrait over the black-and-white one — same hover crossfade as the hero */
      .acard2-photo img.photo-color{
        position:absolute;inset:0;height:100%;opacity:0;pointer-events:none;
        transition:opacity .6s ease,transform .6s cubic-bezier(.22,.8,.3,1);
      }
      .acard2-photo:hover img.photo-color,
      .acard2-photo.show-color img.photo-color{opacity:1;}
      .acard2-photo:hover img,
      .acard2-photo.show-color img{transform:scale(1.03);}
      .acard2-divider{
        position:relative;height:15px;margin:15px 20px 0;border-radius:999px;
        background:linear-gradient(180deg,#fdf6e0,#efdfba);
        border:2px solid #a87c1e;box-shadow:inset 0 -5px 8px rgba(168,124,30,.18);
      }
      .acard2-divider::after{
        content:"";position:absolute;left:50%;top:50%;width:11px;height:11px;
        transform:translate(-50%,-50%) rotate(45deg);
        background:linear-gradient(135deg,#ecd27c,#b8862e);box-shadow:0 0 0 2px #7c5518;
      }
      .acard2-skills{
        position:relative;margin:15px 5px 0;padding:15px 19px 11px;border-radius:9px;
        background:linear-gradient(180deg,#f9f1dc,#eee0bf);
        border:2px solid #a87c1e;
        box-shadow:inset 0 0 0 2px rgba(255,255,255,.5),inset 0 0 26px rgba(168,124,30,.14),0 3px 8px rgba(60,30,10,.22);
        color:#211a10;
      }
      .scorn{position:absolute;width:15px;height:15px;pointer-events:none;}
      .scorn::before{content:"";position:absolute;inset:0;border:0 solid #b8862e;}
      .scorn::after{content:"";position:absolute;width:5px;height:5px;transform:rotate(45deg);background:#8a5a14;}
      .scorn.tl{top:4px;left:4px;}.scorn.tl::before{border-top-width:2px;border-left-width:2px;}
      .scorn.tl::after{top:1px;left:1px;}
      .scorn.tr{top:4px;right:4px;}.scorn.tr::before{border-top-width:2px;border-right-width:2px;}
      .scorn.tr::after{top:1px;right:1px;}
      .scorn.bl{bottom:4px;left:4px;}.scorn.bl::before{border-bottom-width:2px;border-left-width:2px;}
      .scorn.bl::after{bottom:1px;left:1px;}
      .scorn.br{bottom:4px;right:4px;}.scorn.br::before{border-bottom-width:2px;border-right-width:2px;}
      .scorn.br::after{bottom:1px;right:1px;}
      .askill{
        display:grid;grid-template-columns:minmax(86px,1fr) auto 34px;align-items:center;gap:13px;
        padding:9px 0;border-bottom:1px solid rgba(124,85,24,.22);
      }
      .askill:last-child{border-bottom:0;}
      .askill-name{font-family:var(--font-d);font-weight:700;font-size:16.5px;letter-spacing:.01em;}
      .askill-num{font-family:var(--font-d);font-weight:800;font-size:20px;text-align:right;font-variant-numeric:tabular-nums;}
      .dots{display:flex;gap:5px;align-items:center;}
      .dots i{
        width:9px;height:9px;flex:none;transform:rotate(45deg);
        border:1.5px solid #2b2113;background:transparent;
      }
      .dots i.full{background:#2b2113;}
      .dots i.half{background:linear-gradient(90deg,#2b2113 50%,rgba(43,33,19,.12) 50%);}
      .acard2-foot{
        margin:15px 5px 3px;padding:9px 16px;border-radius:999px;
        background:linear-gradient(180deg,#fdf6e0,#efdfba);
        border:2px solid #a87c1e;box-shadow:inset 0 -5px 9px rgba(168,124,30,.16);
        display:flex;align-items:center;justify-content:space-between;gap:8px;
        font-size:11.5px;color:#5a4825;white-space:nowrap;
      }
      .acard2-foot b{color:#1d1710;font-weight:700;font-size:12.5px;margin-left:3px;}
      @media (max-width:560px){
        .amodal-name{font-size:12.5px;letter-spacing:.34em;}
        .amodal-sub{font-size:13.5px;margin-top:6px;}
        .amodal-close{padding:9px 16px;font-size:13.5px;}
        .amodal-center{padding:16px 14px 44px;}
        .acard2{padding:20px 15px 15px;}
        .askill{grid-template-columns:minmax(70px,1fr) auto 30px;gap:9px;padding:8px 0;}
        .askill-name{font-size:15px;}
        .askill-num{font-size:18px;}
        .dots{gap:4px;}
        .dots i{width:7.5px;height:7.5px;}
        .acard2-skills{padding:13px 14px 9px;}
        .acard2-foot{font-size:10px;padding:8px 11px;}
        .acard2-foot b{font-size:11px;}
      }

      /* ---------- responsive ---------- */
      @media (max-width:960px){
        nav.main{display:none;}
        .clock{display:none;}
        .menu-btn{display:flex;margin-left:auto;}
        .brand{margin-right:auto;}
        .hero-grid{grid-template-columns:1fr;}
        .portrait{justify-self:start;width:min(320px,84vw);}
        .ability-grid{grid-template-columns:1fr;}
        .story-grid{grid-template-columns:1fr;}
        .story-side{position:static;}
        .story-side .year{font-size:clamp(76px,20vw,120px);}
        .foot{grid-template-columns:1fr 1fr;}
      }
      @media (max-width:560px){
        .entry .photos{grid-template-columns:1fr;}
        .entry .photos img{height:260px;}
        .foot{grid-template-columns:1fr;}
        .notebook .rings i{width:9px;height:21px;border-width:2.5px;}
        .cord{right:8px;}
        .cord-line{height:80px;}
      }
      @media (prefers-reduced-motion:reduce){
        html{scroll-behavior:auto;}
        .js .rv{opacity:1;transform:none;transition:none;}
        .js .fill{transform:none;transition:none;}
        .note-face.out,.note-face.in{animation:none;}
        .note-face.out::after,.note-face.in::after{animation:none;}
        .acard2-float{animation:none;}
        .acard2{animation:none;}
        .acard2-wrap::before,.acard2-wrap::after{animation:none;}
        .acard2-shine{animation:none;opacity:0;}
        .acard2-holo{transition:none;}
        .acard2-sparkles .sparkle{animation:none;opacity:0;}
        .portrait .arch-in img,.acard2-photo img{transition:none;}
        .cord-swing{transition:none;}
        .cord.pulling .cord-swing{transform:none;transition:none;}
        .amodal .particle{animation:none;}
        .amodal.open .acard2-wrap{animation:none;}
        .portrait .arch{transition:none;}
        .door-leaf,.btn .arr{transition:none;}
      }
    </style>
  </head>
